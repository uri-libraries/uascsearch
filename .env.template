# Environment Configuration Template for URI XML Search
# Copy this file to .env and update the values for your environment

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# SECURITY WARNING: Don't run with debug turned on in production!
DEBUG=False

# Allowed hosts - add your domain names and IP addresses
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS settings for WordPress integration
CORS_ALLOWED_ORIGINS=https://your-wordpress-site.com
